# Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Scratch / test copies
_smoketest/

# Build outputs: regenerated by each day's build.py.
# The published copies live in docs/ (made by publish.py).
day*/out/
day*/web/data.js
day*/web/*_data.js

# Personal blog drafts (made by publish.py)
drafts/

# Large raw downloads (e.g. Citi Bike trip CSVs): re-downloadable, too big to commit
day*/data/raw/

# Cloudflare Worker local state and secrets
.dev.vars
.wrangler/
node_modules/

# Day 13: drawings fetched from the Worker at build time
day13-interactions/data/drawings/

# Day 15: ETOPO1 grid (117 MB, over GitHub's limit); URL in day15-inside-out/build.py
day15-inside-out/data/

# Day 17: NOAA/OSM downloads and test imagery (~80 MB); re-download with day17-light-dark/fetch.py
day17-light-dark/data/

# Day 18: 2020 Census block shapefiles (~10 GB) and processed caches; URLs in day18-null/build.py
day18-null/data/

# Day 20: street-tree points (96 MB, near GitHub's limit); re-download with day20-hexagons/fetch.sh
day20-hexagons/data/trees.csv

# Day 26: OSM Midtown buildings and DEP reservoir operations (~26 MB); re-download with
# day26-water/data_prep.py and day26-water/explore_reservoirs_data.py
day26-water/data/midtown_osm.json
day26-water/data/reservoir_ops.csv
